+    res["wall_s"] = round(time.time() - T0, 1)
+    ce.dump_strict(res, os.path.join(outd, name))
+    log(f"{name}: status={res.get('status')} solve_count={res.get('solve_count')} devices_left={res.get('devices_left')}")
+
+
