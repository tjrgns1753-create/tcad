+    good &= row("1a reversed/invalid pair refused", "pair_diff(a,b) for (4,3),(5,4),(3,5),(3,3)", "PairIndexError x4", raised, all(raised))
+    inc = psi_family(cs, 0.0, 1e-6, 1e-6 + 1e-3)                # increasing changes: D34 tiny, D45 large
